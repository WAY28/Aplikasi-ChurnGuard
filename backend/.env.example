# ============================================================================
# CHECKLIST DEPLOY PRODUCTION (Render dkk) -- variabel di bawah ini TIDAK BOLEH
# dibiarkan nilai default lokalnya. Yang lain di file ini aman dipakai apa
# adanya (sudah masuk akal untuk production juga), kecuali disebutkan lain.
#
#   [ ] DATABASE_URL           -> connection string Postgres production (BUKAN localhost)
#   [ ] JWT_SECRET_KEY         -> secret BARU & unik, jangan pernah pakai punya dev/contoh ini
#   [ ] CORS_ORIGINS           -> tambahkan domain Vercel production yang sebenarnya
#   [ ] COOKIE_SECURE=true     -> WAJIB, frontend & backend beda domain (cross-site)
#   [ ] COOKIE_SAMESITE=none   -> WAJIB, pasangan COOKIE_SECURE di atas (browser
#                                  menolak SameSite=None tanpa Secure=true)
#   [ ] FRONTEND_URL           -> domain Vercel production (dipakai bikin link reset password)
#   [ ] RESEND_API_KEY atau SMTP_*  -> isi SALAH SATU, kalau kosong email reset
#                                       password cuma tercetak di log server (tidak
#                                       benar-benar terkirim ke user asli)
#   [ ] DOCS_ENABLED=false ATAU DOCS_BASIC_AUTH_USER/PASSWORD -> jangan biarkan
#                                       /docs terbuka publik tanpa proteksi
#
# Kalau COOKIE_SECURE/COOKIE_SAMESITE lupa di-set: gejalanya menipu -- login
# kelihatan "berhasil" (dapat respons 200) tapi request berikutnya selalu 401,
# karena cookie tidak pernah benar-benar terkirim balik oleh browser.
# ============================================================================

DATABASE_URL=postgresql://churnguard_user:CHANGE_ME@localhost:5432/churnguard
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Auth: access token (JWT, cookie httpOnly) & refresh token (acak, disimpan
# di-hash di tabel refresh_tokens supaya bisa direvoke). Default di bawah pas
# untuk dev lokal.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# WAJIB diubah di production (Render dkk): frontend & backend beda domain
# (cross-site), jadi cookie httpOnly BUTUH SameSite=none + Secure=true supaya
# browser mau mengirimnya. Kalau lupa di-set, gejalanya: login "berhasil" tapi
# request berikutnya selalu 401 (cookie tidak pernah sampai ke server).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Origin frontend yang diizinkan CORS, dipisah koma. Tambahkan domain produksi
# di sini saat deploy (mis. https://churnguard.example.com). Jangan pakai "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Rate limiting login (opsional, default 5 percobaan gagal / 15 menit per IP)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Lupa password
RESET_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# Pengirim email reset password -- isi SALAH SATU (Brevo, Resend, ATAU SMTP).
# Kalau semuanya kosong, link reset cuma dicetak ke log server (mode dev).
# CATATAN: kalau backend di-host di platform yang blokir SMTP keluar
# (Render dkk, umum di tier gratis untuk cegah spam), SMTP di bawah akan
# gagal dengan "Network is unreachable" -- pakai Brevo atau Resend (HTTPS
# API, bukan SMTP) di platform seperti itu.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=ChurnGuard <onboarding@resend.dev>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Level log (DEBUG/INFO/WARNING/ERROR). Lihat logging_config.py.
LOG_LEVEL=INFO

# Proteksi /docs, /redoc, /openapi.json -- lihat penjelasan 3 mode di config.py.
# Rekomendasi production: DOCS_ENABLED=false, ATAU isi kredensial Basic Auth
# di bawah kalau masih perlu akses docs.
DOCS_ENABLED=true
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASSWORD=
