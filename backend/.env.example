DATABASE_URL=postgresql://churnguard_user:CHANGE_ME@localhost:5432/churnguard
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Auth: access token (JWT, cookie httpOnly) & refresh token (acak, disimpan
# di-hash di tabel refresh_tokens supaya bisa direvoke). Default di bawah pas
# untuk dev lokal.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# WAJIB diubah di production (Render dkk): frontend & backend beda domain
# (cross-site), jadi cookie httpOnly BUTUH SameSite=none + Secure=true supaya
# browser mau mengirimnya. Kalau lupa di-set, gejalanya: login "berhasil" tapi
# request berikutnya selalu 401 (cookie tidak pernah sampai ke server).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Origin frontend yang diizinkan CORS, dipisah koma. Tambahkan domain produksi
# di sini saat deploy (mis. https://churnguard.example.com). Jangan pakai "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Rate limiting login (opsional, default 5 percobaan gagal / 15 menit per IP)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Lupa password
RESET_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# Pengirim email reset password -- isi SALAH SATU (Resend ATAU SMTP Gmail).
# Kalau dua-duanya kosong, link reset cuma dicetak ke log server (mode dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=ChurnGuard <onboarding@resend.dev>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
